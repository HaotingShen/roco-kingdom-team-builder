# Production build env (loaded automatically by `vite build`).
# Hide the site's promo/donation "ad" slots on the live site: sidebar ad, mobile builder ad,
# and the topbar Donate button + donation modal. All are gated on VITE_HIDE_ADS.
# Reversible: set to false or delete this file to bring them back.
# (The TapTap build hides these separately via .env.taptap.)
VITE_HIDE_ADS=true
