# TapTap build configuration
# API is on rkteambuilder.com — must be absolute since the zip is served from TapTap's CDN
VITE_API_BASE_URL=https://rkteambuilder.com/api
# All image paths in images.ts are prefixed with this to resolve correctly from any iframe URL
VITE_ASSET_BASE_URL=https://rkteambuilder.com
# Hide ads in TapTap submission (TapTap rules prohibit ads in tool submissions)
VITE_HIDE_ADS=true
# Hide login/auth UI — TapTap rules prohibit account login functionality
VITE_HIDE_AUTH=true
# Use hash-based routing (#/build, #/dex) — TapTap CDN has no server-side fallback to index.html
VITE_HASH_ROUTER=true
